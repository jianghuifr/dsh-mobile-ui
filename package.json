{
  "name": "@jianghuifr/dsh-mobile-ui",
  "version": "0.1.0",
  "description": "Mobile layout, touch interaction and decluttered chrome for the DeepSeek Harness web GUI, plus Material Icon Theme file icons for its file explorer. Scoped to viewports <= 1023px; the desktop UI is untouched.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "responsive",
    "touch",
    "safe-area",
    "material-icon-theme",
    "file-icons",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "scripts/",
    "test/*.mjs",
    "docs/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser/run.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm run lint && npm test",
    "vendor-icons": "node scripts/vendor-icons.mjs",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianghuifr/dsh-mobile-ui.git"
  },
  "homepage": "https://github.com/jianghuifr/dsh-mobile-ui#readme",
  "bugs": {
    "url": "https://github.com/jianghuifr/dsh-mobile-ui/issues"
  },
  "author": "jianghuifr",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0"
  }
}
